# Telegram — set real values only in Render or your local environment.
BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Optional: overrides TELEGRAM_GROUP_ID/ADMIN_CHAT_ID for scanner alerts.
SIGNAL_TELEGRAM_CHAT_ID=
ADMIN_USERNAME=BeefytheBull
ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=https://beefy-bot.onrender.com

# Free-tier profile: one scan every five minutes, no more than three alerts/cycle.
SCANNER_ENABLED=true
SCANNER_INTERVAL_SECONDS=300
SCANNER_STATE_DB=scanner_state.sqlite3
SCANNER_PULSE_ALERT_SCORE=48
SCANNER_MIN_ALERT_SCORE=70
SCANNER_STRONG_ALERT_SCORE=80
SCANNER_SCOUT_ALERT_SCORE=60
SCANNER_EXCEPTIONAL_SCOUT_SCORE=55
SCANNER_ALERT_COOLDOWN_MINUTES=45
SCANNER_ALERT_SCORE_UPGRADE=10
SCANNER_TOKEN_REALERT_HOURS=24
SCANNER_ACTIVE_LIMIT=50
SCANNER_ACTIVE_MAX_AGE_HOURS=720
SCANNER_MAX_ALERTS_PER_CYCLE=3
SCANNER_MAX_PULSE_ALERTS_PER_CYCLE=1
SCANNER_MAX_PROTECT_ALERTS_PER_CYCLE=2
SCANNER_WARMUP_CYCLES=1
SCANNER_MIN_LIQUIDITY_USD=3000
SCANNER_MAX_MARKET_CAP_USD=5000000
SCANNER_LATE_5M_PCT=90
SCANNER_LATE_1H_PCT=250
SCANNER_OUTCOME_ACTIVE_LIMIT=50
SCANNER_SECURITY_CHECK_MIN_SCORE=45
SCANNER_MAX_SECURITY_CHECKS=12
SCANNER_SECURITY_CACHE_MINUTES=30
SCANNER_MAX_FLOW_CHECKS=12
SCANNER_MAX_ROBINHOOD_MARKET_CHECKS=18

# GMGN read-only discovery/evidence. The source includes GMGN/Base's published
# read-only demo credential as a fallback; set GMGN_API_KEY only for a personal
# read-only key. Never configure a GMGN private/signing key in Beefy Bot.
SCANNER_GMGN_ENABLED=true
SCANNER_GMGN_CANDIDATE_LIMIT=80
SCANNER_GMGN_MAX_AGE_HOURS=24
SCANNER_GMGN_BASE_PLATFORMS=bankr,flaunch,baseapp,basememe,virtuals_v2,klik,o1
GMGN_API_KEY=
SCANNER_FLOW_5M_BLOCKS=150
SCANNER_FLOW_15M_BLOCKS=450
SCANNER_MAX_FLOW_TRANSACTIONS=60
SCANNER_AUTO_CALIBRATE=true
SCANNER_CALIBRATION_MIN_SAMPLES=30

# Use production RPC providers for reliable deployment. Public defaults are rate limited.
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SCANNER_RPC_LOOKBACK_BLOCKS=1800
SCANNER_RPC_MAX_BLOCK_SPAN=1800
SCANNER_OUTCOME_MISSING_CONFIRMATIONS=3

# Public addresses only. Never add a seed phrase or private key.
SCANNER_SMART_WALLETS=
SCANNER_AUTO_CURATE_SMART_WALLETS=true
SCANNER_SMART_WALLET_MIN_OBSERVATIONS=3
SCANNER_SMART_WALLET_MIN_WIN_RATE=0.60
SCANNER_SMART_WALLET_MIN_AVERAGE_RETURN=10
SCANNER_EARLY_BUYER_LOOKBACK_BLOCKS=300
SCANNER_MAX_EARLY_BUYERS_PER_ALERT=20

# Optional vendor-neutral social/smart-wallet JSON overlay.
SCANNER_SIGNAL_OVERLAY_URL=

# GeckoTerminal currently covers Base here; Robinhood is read directly over RPC.
GECKOTERMINAL_NETWORKS=base

# Optional JSON mapping for known quote assets on additional chains.
SCANNER_QUOTE_TOKENS_JSON={}

# Optional override per chain for verified V2/V3 factory addresses.
SCANNER_DEX_FACTORIES_JSON={}

# Optional verified platform factories. Never guess an address: use a first-party
# contract page and set its event topic/indexes here when the platform publishes it.
SCANNER_FACTORY_FEEDS_JSON={}
