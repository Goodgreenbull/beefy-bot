# Telegram — set real values only in Render or your local environment.
BOT_TOKEN=
TELEGRAM_GROUP_ID=
SIGNAL_TELEGRAM_CHAT_ID=
ADMIN_USERNAME=BeefytheBull
ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=https://beefy-bot.onrender.com

# The scanner is opt-in so a deploy cannot unexpectedly send alerts.
SCANNER_ENABLED=false
SCANNER_INTERVAL_SECONDS=45
SCANNER_STATE_DB=scanner_state.sqlite3
SCANNER_MIN_ALERT_SCORE=68
SCANNER_STRONG_ALERT_SCORE=80
SCANNER_ALERT_COOLDOWN_MINUTES=45
SCANNER_ALERT_SCORE_UPGRADE=10
SCANNER_ACTIVE_LIMIT=60
SCANNER_ACTIVE_MAX_AGE_HOURS=720
SCANNER_MIN_LIQUIDITY_USD=3000
SCANNER_MAX_MARKET_CAP_USD=5000000
SCANNER_LATE_5M_PCT=90
SCANNER_LATE_1H_PCT=250

# Use production RPC providers for reliable deployment. Public defaults are rate limited.
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SCANNER_RPC_LOOKBACK_BLOCKS=180
SCANNER_RPC_MAX_BLOCK_SPAN=1800

# Public addresses only. Never add a seed phrase or private key.
SCANNER_SMART_WALLETS=

# Optional vendor-neutral social/smart-wallet JSON overlay.
SCANNER_SIGNAL_OVERLAY_URL=

# GeckoTerminal currently covers Base here; Robinhood is read directly over RPC.
GECKOTERMINAL_NETWORKS=base

# Optional JSON mapping for known quote assets on additional chains.
SCANNER_QUOTE_TOKENS_JSON={}
